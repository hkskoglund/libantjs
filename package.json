  "bugs": {
    "url": "https://github.com/hkskoglund/libantjs/issues"
  },
  "homepage": "https://github.com/hkskoglund/libantjs",
  "dependencies": {
    "loglevel": "^1.9.2",
    "usb": "^1.0.6"
  },
  "allowScripts": {
    "usb@1.9.2": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  }
